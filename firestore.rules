rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function approvedDevice() {
      return signedIn()
        && exists(/databases/$(database)/documents/approved_devices/$(request.auth.uid))
        && get(/databases/$(database)/documents/approved_devices/$(request.auth.uid)).data.approved == true;
    }
    function bankAdminDevice() {
      return approvedDevice()
        && exists(/databases/$(database)/documents/bank_admin_devices/$(request.auth.uid))
        && get(/databases/$(database)/documents/bank_admin_devices/$(request.auth.uid)).data.approved == true;
    }
    function validText(value, maximum) {
      return value is string
        && value.size() > 0
        && value.size() <= maximum;
    }
    function validOptionalText(value, maximum) {
      return value is string && value.size() <= maximum;
    }
    function validShoppingItem() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'text', 'completed', 'shop', 'category', 'priority', 'createdBy',
          'createdAt', 'createdByRole', 'qty', 'unitPrice', 'lastQty', 'lastUnitPrice',
          'expectedUnitPrice'
        ])
        && data.keys().hasAll([
          'text', 'completed', 'shop', 'category', 'priority', 'createdBy',
          'createdAt'
        ])
        && validText(data.text, 80)
        && data.completed is bool
        && validOptionalText(data.shop, 40)
        && validOptionalText(data.category, 40)
        && validOptionalText(data.priority, 20)
        && validText(data.createdBy, 40)
        && (!('createdByRole' in data) || validOptionalText(data.createdByRole, 20))
        && data.createdAt is timestamp
        && (!('qty' in data) || (data.qty is number && data.qty >= 1 && data.qty <= 999))
        && (!('unitPrice' in data) || (data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 99999.99))
        && (!('lastQty' in data) || (data.lastQty is number && data.lastQty >= 1 && data.lastQty <= 999))
        && (!('lastUnitPrice' in data) || (data.lastUnitPrice is number && data.lastUnitPrice >= 0 && data.lastUnitPrice <= 99999.99))
        && (!('expectedUnitPrice' in data) || (data.expectedUnitPrice is number && data.expectedUnitPrice > 0 && data.expectedUnitPrice <= 99999.99));
    }
    match /shopping_items/{itemId} {
      allow read: if approvedDevice();
      allow create: if approvedDevice() && validShoppingItem();
      allow update: if approvedDevice()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completed', 'shop', 'category', 'priority', 'qty', 'unitPrice',
          'lastQty', 'lastUnitPrice'
        ])
        && validShoppingItem();
      allow delete: if approvedDevice();
    }
    function validShoppingPriceHistory() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'itemName', 'normalizedName', 'lastUnitPrice', 'updatedAt',
          'updatedAtMs', 'updatedBy'
        ])
        && data.keys().hasAll([
          'itemName', 'normalizedName', 'lastUnitPrice', 'updatedAt',
          'updatedAtMs', 'updatedBy'
        ])
        && validText(data.itemName, 80)
        && validText(data.normalizedName, 80)
        && data.lastUnitPrice is number
        && data.lastUnitPrice > 0
        && data.lastUnitPrice <= 99999.99
        && data.updatedAt is timestamp
        && data.updatedAtMs is number
        && validText(data.updatedBy, 40);
    }
    match /shopping_price_history/{historyId} {
      allow read: if approvedDevice();
      allow create, update: if approvedDevice() && validShoppingPriceHistory();
      allow delete: if false;
    }
    function validExpense() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'description', 'category', 'amount', 'createdAt', 'createdAtMs',
          'createdBy', 'transactionType', 'amendsExpenseId', 'unusual', 'source',
          'sourceTransactionId', 'sourceAccount'
        ])
        && data.keys().hasAll([
          'description', 'category', 'amount', 'createdAt', 'createdAtMs',
          'createdBy', 'transactionType', 'unusual'
        ])
        && validText(data.description, 80)
        && validText(data.category, 40)
        && data.amount is number
        && data.amount != 0
        && data.amount <= 99999.99
        && data.amount >= -99999.99
        && data.createdAt is timestamp
        && data.createdAtMs is number
        && validText(data.createdBy, 40)
        && data.unusual is bool
        && (!('source' in data) || data.source in ['shopping-transfer', 'up-bank'])
        && (('source' in data) && data.source == 'up-bank'
          ? validText(data.sourceTransactionId, 128)
          : !('sourceTransactionId' in data))
        && (!('sourceAccount' in data) || data.sourceAccount in ['peu', 'shamir'])
        && data.transactionType in ['expense', 'amendment']
        && (data.transactionType == 'expense'
          ? data.amount > 0 && !('amendsExpenseId' in data)
          : validText(data.amendsExpenseId, 128));
    }
    match /expenses/{expenseId} {
      allow read: if approvedDevice();
      allow create: if approvedDevice() && validExpense();
      allow update, delete: if false;
    }
    function validPendingBankTransaction() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'externalId', 'description', 'amount', 'occurredAt', 'occurredAtMs',
          'importedAt', 'importedAtMs', 'importedBy', 'accountKey',
          'accountLabel', 'status'
        ])
        && data.keys().hasAll([
          'externalId', 'description', 'amount', 'occurredAt', 'occurredAtMs',
          'importedAt', 'importedAtMs', 'importedBy', 'accountKey',
          'accountLabel', 'status'
        ])
        && validText(data.externalId, 128)
        && validText(data.description, 80)
        && data.amount is number
        && data.amount > 0
        && data.amount <= 99999.99
        && validText(data.occurredAt, 40)
        && data.occurredAtMs is number
        && data.importedAt is timestamp
        && data.importedAtMs is number
        && validText(data.importedBy, 40)
        && data.accountKey in ['peu', 'shamir']
        && validText(data.accountLabel, 40)
        && data.status in ['HELD', 'SETTLED'];
    }
    match /pending_bank_transactions/{transactionId} {
      allow read: if bankAdminDevice();
      allow create: if bankAdminDevice()
        && transactionId == request.resource.data.accountKey + '__' + request.resource.data.externalId
        && validPendingBankTransaction();
      allow update: if bankAdminDevice()
        && transactionId == resource.data.accountKey + '__' + resource.data.externalId
        && request.resource.data.accountKey == resource.data.accountKey
        && request.resource.data.externalId == resource.data.externalId
        && request.resource.data.importedAt == resource.data.importedAt
        && request.resource.data.importedAtMs == resource.data.importedAtMs
        && request.resource.data.importedBy == resource.data.importedBy
        && validPendingBankTransaction();
      allow delete: if bankAdminDevice();
    }
    function validProcessedBankTransaction() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'decision', 'processedAt', 'processedAtMs', 'processedBy', 'expenseId',
          'accountKey', 'externalId'
        ])
        && data.keys().hasAll([
          'decision', 'processedAt', 'processedAtMs', 'processedBy'
        ])
        && data.decision in ['accepted', 'rejected']
        && data.processedAt is timestamp
        && data.processedAtMs is number
        && validText(data.processedBy, 40)
        && (data.decision == 'accepted'
          ? validText(data.expenseId, 128)
          : !('expenseId' in data))
        && (!('accountKey' in data) || data.accountKey in ['peu', 'shamir'])
        && (!('externalId' in data) || validText(data.externalId, 128));
    }
    match /processed_bank_transactions/{transactionId} {
      allow get: if bankAdminDevice();
      allow list: if false;
      allow create: if bankAdminDevice()
        && validProcessedBankTransaction()
        && ((!('accountKey' in request.resource.data) && !('externalId' in request.resource.data))
          || (transactionId == request.resource.data.accountKey + '__' + request.resource.data.externalId));
      allow update, delete: if false;
    }
    function validBankSyncStatus() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'lastSyncedAt', 'lastSyncedAtMs', 'lastSinceMs', 'importedCount',
          'updatedBy', 'accountKey'
        ])
        && data.keys().hasAll([
          'lastSyncedAt', 'lastSyncedAtMs', 'lastSinceMs', 'importedCount',
          'updatedBy', 'accountKey'
        ])
        && data.lastSyncedAt is timestamp
        && data.lastSyncedAtMs is number
        && (data.lastSinceMs == null || data.lastSinceMs is number)
        && data.importedCount is int
        && data.importedCount >= 0
        && data.importedCount <= 1000
        && validText(data.updatedBy, 40)
        && data.accountKey in ['peu', 'shamir'];
    }
    match /bank_sync/{accountKey} {
      allow get: if bankAdminDevice();
      allow list, delete: if false;
      allow create, update: if bankAdminDevice()
        && request.resource.data.accountKey == accountKey
        && validBankSyncStatus();
    }
    function validBankSyncAudit() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'accountKey', 'accountLabel', 'status', 'occurredAt',
          'occurredAtMs', 'deviceUid'
        ])
        && data.keys().hasAll([
          'accountKey', 'accountLabel', 'status', 'occurredAt',
          'occurredAtMs', 'deviceUid'
        ])
        && data.accountKey in ['peu', 'shamir']
        && validText(data.accountLabel, 40)
        && data.status in ['success', 'failed']
        && data.occurredAt is timestamp
        && data.occurredAtMs is number
        && data.occurredAtMs > 0
        && data.deviceUid == request.auth.uid;
    }
    match /bank_sync_audit/{auditId} {
      allow read: if bankAdminDevice();
      allow create: if bankAdminDevice()
        && validBankSyncAudit()
        && request.resource.data.occurredAt == request.time;
      allow update, delete: if false;
    }
    match /bank_admin_devices/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    function validOptionList(value) {
      return value is list
        && value.size() > 0
        && value.size() <= 100;
    }
    function validCategoryConfig() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'shops', 'shopping', 'expenses', 'shopAliases', 'shoppingAliases', 'expenseAliases',
          'updatedAt', 'updatedAtMs', 'updatedBy'
        ])
        && data.keys().hasAll([
          'shops', 'shopping', 'expenses', 'updatedAt', 'updatedAtMs', 'updatedBy'
        ])
        // These lists deliberately validate shape, not specific names. Adding,
        // renaming, or removing an option therefore never requires another
        // Firestore Rules deployment.
        && validOptionList(data.shops)
        && validOptionList(data.shopping)
        && validOptionList(data.expenses)
        // Alias maps are optional for compatibility with an older config
        // document, and are written automatically after the next rename.
        && (!('shopAliases' in data) || data.shopAliases is map)
        && (!('shoppingAliases' in data) || data.shoppingAliases is map)
        && (!('expenseAliases' in data) || data.expenseAliases is map)
        && data.updatedAt is timestamp
        && data.updatedAtMs is number
        && validText(data.updatedBy, 40);
    }
    match /app_config/categories {
      allow read: if approvedDevice();
      // Shared options are an owner-admin operation. Reuse the manually
      // controlled bank-admin device allow-list as the trusted owner boundary.
      allow create, update: if bankAdminDevice() && validCategoryConfig();
      allow delete: if false;
    }
    function validDateKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validForecastAmount(value) {
      return value is number && value >= 0 && value <= 9999999.99;
    }
    function validForecastSchedule() {
      let data = request.resource.data;
      return data.keys().hasOnly(['kind', 'name', 'amount', 'frequency', 'firstDate', 'active', 'createdAt', 'createdAtMs', 'createdBy', 'inactiveAt', 'inactiveReason'])
        && data.keys().hasAll(['kind', 'name', 'amount', 'frequency', 'firstDate', 'active', 'createdAt', 'createdAtMs', 'createdBy'])
        && data.kind in ['income', 'expense']
        && validText(data.name, 80)
        && validForecastAmount(data.amount) && data.amount > 0
        && data.frequency in ['weekly', 'fortnightly', 'monthly', 'quarterly', 'yearly']
        && validDateKey(data.firstDate)
        && data.active is bool
        && data.createdAt is timestamp && data.createdAtMs is number
        && validText(data.createdBy, 40)
        && (data.active
          ? !('inactiveAt' in data) && !('inactiveReason' in data)
          : validDateKey(data.inactiveAt) && validText(data.inactiveReason, 160));
    }
    match /forecast_schedules/{scheduleId} {
      allow read: if bankAdminDevice();
      allow create: if bankAdminDevice() && validForecastSchedule() && request.resource.data.active == true && request.resource.data.createdAt == request.time;
      allow update: if bankAdminDevice()
        && resource.data.active == true && request.resource.data.active == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'inactiveAt', 'inactiveReason'])
        && validForecastSchedule();
      allow delete: if false;
    }
    function validForecastOneOff() {
      let data = request.resource.data;
      return data.keys().hasOnly(['kind', 'description', 'amount', 'dateKey', 'createdAt', 'createdAtMs', 'createdBy'])
        && data.keys().hasAll(['kind', 'description', 'amount', 'dateKey', 'createdAt', 'createdAtMs', 'createdBy'])
        && data.kind in ['income', 'expense', 'adjustment'] && validText(data.description, 80)
        && (data.kind == 'adjustment'
          ? data.amount is number && data.amount >= -9999999.99 && data.amount <= 9999999.99 && data.amount != 0
          : validForecastAmount(data.amount) && data.amount > 0)
        && validDateKey(data.dateKey)
        && data.createdAt is timestamp && data.createdAtMs is number && validText(data.createdBy, 40);
    }
    match /forecast_one_offs/{entryId} {
      allow read: if bankAdminDevice();
      allow create: if bankAdminDevice() && validForecastOneOff() && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    function validForecastMonth(monthId) {
      let data = request.resource.data;
      return monthId.matches('^[0-9]{4}-[0-9]{2}$')
        && data.keys().hasOnly(['openingBalance', 'updatedAt', 'updatedAtMs', 'updatedBy'])
        && data.keys().hasAll(['openingBalance', 'updatedAt', 'updatedAtMs', 'updatedBy'])
        && data.openingBalance is number && data.openingBalance >= -9999999.99 && data.openingBalance <= 9999999.99
        && data.updatedAt is timestamp && data.updatedAtMs is number && validText(data.updatedBy, 40);
    }
    match /forecast_months/{monthId} {
      allow read: if bankAdminDevice();
      allow create, update: if bankAdminDevice() && validForecastMonth(monthId) && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function validForecastOverride(overrideId) {
      let data = request.resource.data;
      return overrideId == data.dateKey && validDateKey(data.dateKey)
        && data.keys().hasOnly(['dateKey', 'amount', 'excluded', 'excludedExpenseIds', 'locked', 'updatedAt', 'updatedAtMs', 'updatedBy'])
        && data.keys().hasAll(['dateKey', 'amount', 'excluded', 'updatedAt', 'updatedAtMs', 'updatedBy'])
        && validForecastAmount(data.amount) && data.excluded is bool
        && (!('excludedExpenseIds' in data) || (data.excludedExpenseIds is list && data.excludedExpenseIds.size() <= 200))
        && (!('locked' in data) || data.locked is bool)
        && data.updatedAt is timestamp && data.updatedAtMs is number && validText(data.updatedBy, 40);
    }
    match /forecast_overrides/{overrideId} {
      allow read: if bankAdminDevice();
      allow create, update: if bankAdminDevice() && validForecastOverride(overrideId) && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function validForecastOccurrenceOverride(occurrenceId) {
      let data = request.resource.data;
      return occurrenceId == data.occurrenceId
        && data.keys().hasOnly(['occurrenceId', 'scheduleId', 'dateKey', 'name', 'amount', 'excluded', 'createdAt', 'createdAtMs', 'createdBy'])
        && data.keys().hasAll(['occurrenceId', 'scheduleId', 'dateKey', 'name', 'amount', 'excluded', 'createdAt', 'createdAtMs', 'createdBy'])
        && validText(data.occurrenceId, 160) && validText(data.scheduleId, 120) && validDateKey(data.dateKey)
        && validText(data.name, 80) && validForecastAmount(data.amount) && data.amount > 0 && data.excluded == true
        && exists(/databases/$(database)/documents/forecast_schedules/$(data.scheduleId))
        && get(/databases/$(database)/documents/forecast_schedules/$(data.scheduleId)).data.kind == 'expense'
        && get(/databases/$(database)/documents/forecast_schedules/$(data.scheduleId)).data.name == data.name
        && get(/databases/$(database)/documents/forecast_schedules/$(data.scheduleId)).data.amount == data.amount
        && data.createdAt is timestamp && data.createdAtMs is number && validText(data.createdBy, 40);
    }
    match /forecast_occurrence_overrides/{occurrenceId} {
      allow read: if bankAdminDevice();
      allow create: if bankAdminDevice() && validForecastOccurrenceOverride(occurrenceId) && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    function validForecastAudit() {
      let data = request.resource.data;
      return data.keys().hasOnly(['action', 'subject', 'oldValue', 'newValue', 'reason', 'createdAt', 'createdAtMs', 'createdBy'])
        && data.keys().hasAll(['action', 'subject', 'oldValue', 'newValue', 'reason', 'createdAt', 'createdAtMs', 'createdBy'])
        && data.action in ['opening_balance_changed', 'daily_expense_adjusted', 'daily_expense_excluded', 'daily_expense_selection_changed', 'daily_expense_amount_locked', 'recurring_occurrence_excluded', 'schedule_created', 'schedule_inactivated', 'one_off_created']
        && validText(data.subject, 120) && validOptionalText(data.oldValue, 120) && validOptionalText(data.newValue, 120)
        && validText(data.reason, 160) && data.createdAt is timestamp && data.createdAtMs is number && validText(data.createdBy, 40);
    }
    match /forecast_audit/{auditId} {
      allow read: if bankAdminDevice();
      allow create: if bankAdminDevice() && validForecastAudit() && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    function validPersonalLoan() {
      let data = request.resource.data;
      return data.keys().hasOnly(['lender', 'reason', 'originalAmount', 'takenDate', 'createdAt', 'createdAtMs', 'createdBy'])
        && data.keys().hasAll(['lender', 'reason', 'originalAmount', 'takenDate', 'createdAt', 'createdAtMs', 'createdBy'])
        && validText(data.lender, 80)
        && validText(data.reason, 160)
        && validForecastAmount(data.originalAmount) && data.originalAmount > 0
        && validDateKey(data.takenDate)
        && data.createdAt is timestamp && data.createdAtMs is number
        && validText(data.createdBy, 40);
    }
    match /personal_loans/{loanId} {
      allow read: if bankAdminDevice();
      allow create: if bankAdminDevice() && validPersonalLoan() && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    function validPersonalLoanRepayment() {
      let data = request.resource.data;
      return data.keys().hasOnly(['loanId', 'amount', 'repaidDate', 'createdAt', 'createdAtMs', 'createdBy'])
        && data.keys().hasAll(['loanId', 'amount', 'repaidDate', 'createdAt', 'createdAtMs', 'createdBy'])
        && validText(data.loanId, 120)
        && exists(/databases/$(database)/documents/personal_loans/$(data.loanId))
        && validForecastAmount(data.amount) && data.amount > 0
        && validDateKey(data.repaidDate)
        && data.createdAt is timestamp && data.createdAtMs is number
        && validText(data.createdBy, 40);
    }
    match /personal_loan_repayments/{repaymentId} {
      allow read: if bankAdminDevice();
      allow create: if bankAdminDevice() && validPersonalLoanRepayment() && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    function validWish() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'name', 'targetCents', 'balanceCents', 'deadlineDate', 'eventDate', 'status',
          'createdAt', 'createdAtMs', 'createdBy', 'updatedAt', 'updatedAtMs', 'updatedBy',
          'lastTransactionId', 'terminatedAt', 'terminatedAtMs'
        ])
        && data.keys().hasAll([
          'name', 'targetCents', 'balanceCents', 'deadlineDate', 'eventDate', 'status',
          'createdAt', 'createdAtMs', 'createdBy', 'updatedAt', 'updatedAtMs', 'updatedBy'
        ])
        && validText(data.name, 80)
        && data.targetCents is int && data.targetCents > 0 && data.targetCents <= 999999999
        && data.balanceCents is int && data.balanceCents >= 0 && data.balanceCents <= 999999999
        && validDateKey(data.deadlineDate) && validDateKey(data.eventDate)
        && data.deadlineDate <= data.eventDate
        && data.status in ['active', 'terminated']
        && data.createdAt is timestamp && data.createdAtMs is number && validText(data.createdBy, 40)
        && data.updatedAt is timestamp && data.updatedAtMs is number && validText(data.updatedBy, 40)
        && (!('lastTransactionId' in data) || validText(data.lastTransactionId, 120))
        && (data.status == 'terminated'
          ? data.balanceCents == 0 && data.terminatedAt is timestamp && data.terminatedAtMs is number
          : !('terminatedAt' in data) && !('terminatedAtMs' in data));
    }
    function validWishTransaction() {
      let data = request.resource.data;
      return data.keys().hasOnly(['wishId', 'type', 'amountCents', 'dateKey', 'note', 'createdAt', 'createdAtMs', 'createdBy'])
        && data.keys().hasAll(['wishId', 'type', 'amountCents', 'dateKey', 'note', 'createdAt', 'createdAtMs', 'createdBy'])
        && validText(data.wishId, 120)
        && data.type in ['contribution', 'withdrawal', 'termination_refund']
        && data.amountCents is int && data.amountCents >= 0 && data.amountCents <= 999999999
        && (data.type == 'termination_refund' || data.amountCents > 0)
        && validDateKey(data.dateKey)
        && validOptionalText(data.note, 160)
        && data.createdAt is timestamp && data.createdAtMs is number && validText(data.createdBy, 40);
    }
    function validWishTransition(wishId) {
      let transactionId = request.resource.data.lastTransactionId;
      let entry = getAfter(/databases/$(database)/documents/wish_transactions/$(transactionId)).data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'balanceCents', 'status', 'lastTransactionId', 'terminatedAt', 'terminatedAtMs',
          'updatedAt', 'updatedAtMs', 'updatedBy'
        ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && entry.wishId == wishId
        && ((entry.type == 'contribution'
            && request.resource.data.status == 'active'
            && request.resource.data.balanceCents == resource.data.balanceCents + entry.amountCents)
          || (entry.type == 'withdrawal'
            && request.resource.data.status == 'active'
            && entry.amountCents <= resource.data.balanceCents
            && request.resource.data.balanceCents == resource.data.balanceCents - entry.amountCents)
          || (entry.type == 'termination_refund'
            && request.resource.data.status == 'terminated'
            && request.resource.data.balanceCents == 0
            && entry.amountCents == resource.data.balanceCents
            && request.resource.data.terminatedAt == request.time));
    }
    match /wishes/{wishId} {
      allow read: if bankAdminDevice();
      allow create: if bankAdminDevice()
        && validWish()
        && request.resource.data.status == 'active'
        && request.resource.data.balanceCents == 0
        && !('lastTransactionId' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if bankAdminDevice()
        && resource.data.status == 'active'
        && validWish()
        && validWishTransition(wishId);
      allow delete: if false;
    }
    match /wish_transactions/{transactionId} {
      allow read: if bankAdminDevice();
      allow create: if bankAdminDevice()
        && validWishTransaction()
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/wishes/$(request.resource.data.wishId))
        && get(/databases/$(database)/documents/wishes/$(request.resource.data.wishId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/wishes/$(request.resource.data.wishId)).data.lastTransactionId == transactionId;
      allow update, delete: if false;
    }
    function isImprovementHistory(status) {
      return status in ['done', 'not_doing', 'duplicate'];
    }
    function validImprovementLog() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'type', 'title', 'notes', 'status', 'createdAt', 'createdAtMs', 'createdBy',
          'updatedAt', 'updatedAtMs', 'updatedBy', 'resolutionSummary', 'resolvedAt', 'resolvedAtMs'
        ])
        && data.keys().hasAll([
          'type', 'title', 'notes', 'status', 'createdAt', 'createdAtMs', 'createdBy',
          'updatedAt', 'updatedAtMs', 'updatedBy'
        ])
        && data.type in ['bug', 'ui_change', 'feature']
        && validText(data.title, 120)
        && validOptionalText(data.notes, 1200)
        && data.status in ['inbox', 'agreed', 'in_progress', 'done', 'not_doing', 'duplicate']
        && data.createdAt is timestamp && data.createdAtMs is number && validText(data.createdBy, 40)
        && data.updatedAt is timestamp && data.updatedAtMs is number && validText(data.updatedBy, 40)
        && (isImprovementHistory(data.status)
          ? validText(data.resolutionSummary, 1200) && data.resolvedAt is timestamp && data.resolvedAtMs is number
          : !('resolutionSummary' in data) && !('resolvedAt' in data) && !('resolvedAtMs' in data));
    }
    match /improvement_logs/{entryId} {
      allow read: if bankAdminDevice();
      allow create: if bankAdminDevice()
        && validImprovementLog()
        && request.resource.data.status == 'inbox'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if bankAdminDevice()
        && !isImprovementHistory(resource.data.status)
        && validImprovementLog()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && (resource.data.status == 'inbox'
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'updatedAtMs', 'updatedBy',
            'resolutionSummary', 'resolvedAt', 'resolvedAtMs'
          ]))
        && (!isImprovementHistory(request.resource.data.status) || request.resource.data.resolvedAt == request.time);
      allow delete: if bankAdminDevice() && resource.data.status == 'inbox';
    }
    // Login needs to read the selected household user after anonymous auth.
    // User profiles cannot be changed from the app.
    match /families/{familyId}/users/{userId} {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }
    match /pending_devices/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'familyCode', 'username', 'requestedAt'
        ])
        && validText(request.resource.data.familyCode, 40)
        && validText(request.resource.data.username, 30)
        && request.resource.data.requestedAt is timestamp;
      allow update, delete: if false;
    }
    match /approved_devices/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    // The removed notification feature cannot consume Firestore quota.
    match /notification_requests/{requestId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
