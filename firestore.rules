rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function approvedDevice() {
      return signedIn()
        && exists(/databases/$(database)/documents/approved_devices/$(request.auth.uid))
        && get(/databases/$(database)/documents/approved_devices/$(request.auth.uid)).data.approved == true;
    }
    function bankAdminDevice() {
      return approvedDevice()
        && exists(/databases/$(database)/documents/bank_admin_devices/$(request.auth.uid))
        && get(/databases/$(database)/documents/bank_admin_devices/$(request.auth.uid)).data.approved == true;
    }
    function validText(value, maximum) {
      return value is string
        && value.size() > 0
        && value.size() <= maximum;
    }
    function validOptionalText(value, maximum) {
      return value is string && value.size() <= maximum;
    }
    function validShoppingItem() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'text', 'completed', 'shop', 'category', 'priority', 'createdBy',
          'createdAt', 'createdByRole', 'qty', 'unitPrice', 'lastQty', 'lastUnitPrice',
          'expectedUnitPrice'
        ])
        && data.keys().hasAll([
          'text', 'completed', 'shop', 'category', 'priority', 'createdBy',
          'createdAt'
        ])
        && validText(data.text, 80)
        && data.completed is bool
        && validOptionalText(data.shop, 40)
        && validOptionalText(data.category, 40)
        && validOptionalText(data.priority, 20)
        && validText(data.createdBy, 40)
        && (!('createdByRole' in data) || validOptionalText(data.createdByRole, 20))
        && data.createdAt is timestamp
        && (!('qty' in data) || (data.qty is number && data.qty >= 1 && data.qty <= 999))
        && (!('unitPrice' in data) || (data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 99999.99))
        && (!('lastQty' in data) || (data.lastQty is number && data.lastQty >= 1 && data.lastQty <= 999))
        && (!('lastUnitPrice' in data) || (data.lastUnitPrice is number && data.lastUnitPrice >= 0 && data.lastUnitPrice <= 99999.99))
        && (!('expectedUnitPrice' in data) || (data.expectedUnitPrice is number && data.expectedUnitPrice > 0 && data.expectedUnitPrice <= 99999.99));
    }
    match /shopping_items/{itemId} {
      allow read: if approvedDevice();
      allow create: if approvedDevice() && validShoppingItem();
      allow update: if approvedDevice()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completed', 'shop', 'category', 'priority', 'qty', 'unitPrice',
          'lastQty', 'lastUnitPrice'
        ])
        && validShoppingItem();
      allow delete: if approvedDevice();
    }
    function validShoppingPriceHistory() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'itemName', 'normalizedName', 'lastUnitPrice', 'updatedAt',
          'updatedAtMs', 'updatedBy'
        ])
        && data.keys().hasAll([
          'itemName', 'normalizedName', 'lastUnitPrice', 'updatedAt',
          'updatedAtMs', 'updatedBy'
        ])
        && validText(data.itemName, 80)
        && validText(data.normalizedName, 80)
        && data.lastUnitPrice is number
        && data.lastUnitPrice > 0
        && data.lastUnitPrice <= 99999.99
        && data.updatedAt is timestamp
        && data.updatedAtMs is number
        && validText(data.updatedBy, 40);
    }
    match /shopping_price_history/{historyId} {
      allow read: if approvedDevice();
      allow create, update: if approvedDevice() && validShoppingPriceHistory();
      allow delete: if false;
    }
    function validExpense() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'description', 'category', 'amount', 'createdAt', 'createdAtMs',
          'createdBy', 'transactionType', 'amendsExpenseId', 'unusual', 'source',
          'sourceTransactionId', 'sourceAccount'
        ])
        && data.keys().hasAll([
          'description', 'category', 'amount', 'createdAt', 'createdAtMs',
          'createdBy', 'transactionType', 'unusual'
        ])
        && validText(data.description, 80)
        && validText(data.category, 40)
        && data.amount is number
        && data.amount != 0
        && data.amount <= 99999.99
        && data.amount >= -99999.99
        && data.createdAt is timestamp
        && data.createdAtMs is number
        && validText(data.createdBy, 40)
        && data.unusual is bool
        && (!('source' in data) || data.source in ['shopping-transfer', 'up-bank'])
        && (('source' in data) && data.source == 'up-bank'
          ? validText(data.sourceTransactionId, 128)
          : !('sourceTransactionId' in data))
        && (!('sourceAccount' in data) || data.sourceAccount in ['peu', 'shamir'])
        && data.transactionType in ['expense', 'amendment']
        && (data.transactionType == 'expense'
          ? data.amount > 0 && !('amendsExpenseId' in data)
          : validText(data.amendsExpenseId, 128));
    }
    match /expenses/{expenseId} {
      allow read: if approvedDevice();
      allow create: if approvedDevice() && validExpense();
      allow update, delete: if false;
    }
    function validPendingBankTransaction() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'externalId', 'description', 'amount', 'occurredAt', 'occurredAtMs',
          'importedAt', 'importedAtMs', 'importedBy', 'accountKey',
          'accountLabel', 'status'
        ])
        && data.keys().hasAll([
          'externalId', 'description', 'amount', 'occurredAt', 'occurredAtMs',
          'importedAt', 'importedAtMs', 'importedBy', 'accountKey',
          'accountLabel', 'status'
        ])
        && validText(data.externalId, 128)
        && validText(data.description, 80)
        && data.amount is number
        && data.amount > 0
        && data.amount <= 99999.99
        && validText(data.occurredAt, 40)
        && data.occurredAtMs is number
        && data.importedAt is timestamp
        && data.importedAtMs is number
        && validText(data.importedBy, 40)
        && data.accountKey in ['peu', 'shamir']
        && validText(data.accountLabel, 40)
        && data.status in ['HELD', 'SETTLED'];
    }
    match /pending_bank_transactions/{transactionId} {
      allow read: if bankAdminDevice();
      allow create: if bankAdminDevice()
        && transactionId == request.resource.data.accountKey + '__' + request.resource.data.externalId
        && validPendingBankTransaction();
      allow update: if bankAdminDevice()
        && transactionId == resource.data.accountKey + '__' + resource.data.externalId
        && request.resource.data.accountKey == resource.data.accountKey
        && request.resource.data.externalId == resource.data.externalId
        && request.resource.data.importedAt == resource.data.importedAt
        && request.resource.data.importedAtMs == resource.data.importedAtMs
        && request.resource.data.importedBy == resource.data.importedBy
        && validPendingBankTransaction();
      allow delete: if bankAdminDevice();
    }
    function validProcessedBankTransaction() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'decision', 'processedAt', 'processedAtMs', 'processedBy', 'expenseId',
          'accountKey', 'externalId'
        ])
        && data.keys().hasAll([
          'decision', 'processedAt', 'processedAtMs', 'processedBy'
        ])
        && data.decision in ['accepted', 'rejected']
        && data.processedAt is timestamp
        && data.processedAtMs is number
        && validText(data.processedBy, 40)
        && (data.decision == 'accepted'
          ? validText(data.expenseId, 128)
          : !('expenseId' in data))
        && (!('accountKey' in data) || data.accountKey in ['peu', 'shamir'])
        && (!('externalId' in data) || validText(data.externalId, 128));
    }
    match /processed_bank_transactions/{transactionId} {
      allow get: if bankAdminDevice();
      allow list: if false;
      allow create: if bankAdminDevice()
        && validProcessedBankTransaction()
        && ((!('accountKey' in request.resource.data) && !('externalId' in request.resource.data))
          || (transactionId == request.resource.data.accountKey + '__' + request.resource.data.externalId));
      allow update, delete: if false;
    }
    function validBankSyncStatus() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'lastSyncedAt', 'lastSyncedAtMs', 'lastSinceMs', 'importedCount',
          'updatedBy', 'accountKey'
        ])
        && data.keys().hasAll([
          'lastSyncedAt', 'lastSyncedAtMs', 'lastSinceMs', 'importedCount',
          'updatedBy', 'accountKey'
        ])
        && data.lastSyncedAt is timestamp
        && data.lastSyncedAtMs is number
        && (data.lastSinceMs == null || data.lastSinceMs is number)
        && data.importedCount is int
        && data.importedCount >= 0
        && data.importedCount <= 1000
        && validText(data.updatedBy, 40)
        && data.accountKey in ['peu', 'shamir'];
    }
    match /bank_sync/{accountKey} {
      allow get: if bankAdminDevice();
      allow list, delete: if false;
      allow create, update: if bankAdminDevice()
        && request.resource.data.accountKey == accountKey
        && validBankSyncStatus();
    }
    match /bank_admin_devices/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    function validOptionList(value) {
      return value is list
        && value.size() > 0
        && value.size() <= 100;
    }
    function validCategoryConfig() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'shops', 'shopping', 'expenses', 'shopAliases', 'shoppingAliases', 'expenseAliases',
          'updatedAt', 'updatedAtMs', 'updatedBy'
        ])
        && data.keys().hasAll([
          'shops', 'shopping', 'expenses', 'updatedAt', 'updatedAtMs', 'updatedBy'
        ])
        // These lists deliberately validate shape, not specific names. Adding,
        // renaming, or removing an option therefore never requires another
        // Firestore Rules deployment.
        && validOptionList(data.shops)
        && validOptionList(data.shopping)
        && validOptionList(data.expenses)
        // Alias maps are optional for compatibility with an older config
        // document, and are written automatically after the next rename.
        && (!('shopAliases' in data) || data.shopAliases is map)
        && (!('shoppingAliases' in data) || data.shoppingAliases is map)
        && (!('expenseAliases' in data) || data.expenseAliases is map)
        && data.updatedAt is timestamp
        && data.updatedAtMs is number
        && validText(data.updatedBy, 40);
    }
    match /app_config/categories {
      allow read: if approvedDevice();
      // The Admin section is hidden for non-owners. Backend owner enforcement
      // will be tightened when approved-device role metadata is introduced.
      allow create, update: if approvedDevice() && validCategoryConfig();
      allow delete: if false;
    }
    // Login needs to read the selected household user after anonymous auth.
    // User profiles cannot be changed from the app.
    match /families/{familyId}/users/{userId} {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }
    match /pending_devices/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'familyCode', 'username', 'requestedAt'
        ])
        && validText(request.resource.data.familyCode, 40)
        && validText(request.resource.data.username, 30)
        && request.resource.data.requestedAt is timestamp;
      allow update, delete: if false;
    }
    match /approved_devices/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    // The removed notification feature cannot consume Firestore quota.
    match /notification_requests/{requestId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
